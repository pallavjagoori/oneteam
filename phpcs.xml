<?xml version="1.0"?>
<!--
  OneTeam PHP coding standard: PSR-12 plus PHPDoc on every class, property and
  function. Run it with `composer lint` (or `composer lint:fix` for the parts
  PHP_CodeSniffer can repair). See docs/coding-standards.md.
-->
<ruleset name="OneTeam">
  <description>PSR-12 with required PHPDoc blocks.</description>

  <!-- OneTeam's own PHP. Add the Laravel app's directories here as they appear. -->
  <file>tools</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>upstream/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="PSR12"/>

  <!-- Docblocks are well formed: summary first, blank line, then tags. -->
  <rule ref="Generic.Commenting.DocComment">
    <exclude name="Generic.Commenting.DocComment.TagValueIndent"/>
    <exclude name="Generic.Commenting.DocComment.NonParamGroup"/>
    <exclude name="Generic.Commenting.DocComment.ParamNotFirst"/>
    <exclude name="Generic.Commenting.DocComment.TagsNotGrouped"/>
  </rule>

  <!--
    Every function and method has a docblock with an @param (type, name and a
    description) for each parameter, an @return and an @throws for what it
    throws. The excluded checks are about punctuation, or duplicate the native
    type declarations, which static analysis checks instead.
  -->
  <rule ref="Squiz.Commenting.FunctionComment">
    <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
    <exclude name="Squiz.Commenting.FunctionComment.ThrowsNoFullStop"/>
    <exclude name="Squiz.Commenting.FunctionComment.TypeHintMissing"/>
    <exclude name="Squiz.Commenting.FunctionComment.ScalarTypeHintMissing"/>
    <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamType"/>
    <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamName"/>
    <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
    <exclude name="Squiz.Commenting.FunctionComment.IncorrectParamVarName"/>
    <exclude name="Squiz.Commenting.FunctionComment.InvalidReturn"/>
  </rule>
  <rule ref="Squiz.Commenting.FunctionCommentThrowTag"/>

  <!-- Every class, interface, trait and enum, and every property, has a docblock. -->
  <rule ref="Squiz.Commenting.ClassComment">
    <exclude name="Squiz.Commenting.ClassComment.TagNotAllowed"/>
  </rule>
  <rule ref="Squiz.Commenting.VariableComment"/>
</ruleset>
