{
    "name": "pallavjagoori/oneteam",
    "description": "An open PHP (Laravel) version of Chatwoot.",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "pestphp/pest": "^3.8",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "contract": "contract/run.sh",
        "test:harness": "pest --configuration=contract/support/phpunit.xml --test-directory=contract/support/tests --coverage-text"
    },
    "config": {
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "OneTeam\\Contract\\": "contract/support/src/"
        }
    }
}
